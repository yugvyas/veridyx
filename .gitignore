.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.DS_Store

# The raw EMSCAD CSV is redistributable but large and reproducible: `veridyx.data`
# re-fetches it from the Hugging Face mirror and verifies the checksum recorded in
# data/dataset.lock.json. The lock file IS committed; the payload is not.
data/raw/

# The deployable model IS committed. Streamlit Community Cloud builds from this
# repository, so an artifact that exists only on a laptop means an endpoint that
# cannot start. 4.2 MB, regenerated by `python -m veridyx.train`.
#
# Note the glob: `artifacts/` would exclude the directory itself, and git cannot
# re-include a file inside an excluded directory — the negations below would be
# silently ignored. `artifacts/*` excludes the contents instead, which negation can
# then override.
artifacts/*
!artifacts/lightgbm-portable.pkl
!artifacts/lightgbm-portable.json
!artifacts/deployment.json
