# The raw EMSCAD CSV is redistributable but large and reproducible: `veridyx.data`
# re-fetches it from the Hugging Face mirror and verifies the checksum recorded in
# data/dataset.lock.json. The lock file IS committed; the payload is not.
data/raw/

# Trained model artifacts. Regenerated by the training entrypoints; the metrics
# they produce (experiments/*.json) are committed instead.
artifacts/
